        "jsCode": "function event(lead_id, step, state, summary, detail) {\n  return { json: { lead_id, step, state, summary: String(summary).slice(0, 300), detail: detail === undefined ? '' : JSON.stringify(detail) } };\n}\nfunction errorText(e) {\n  if (!e) return 'unknown error';\n  let t = typeof e === 'string' ? e : [e.message, e.description].filter(Boolean).map(String).join(': ') || JSON.stringify(e);\n  // n8n reports HTTP errors as: 503 - \"{\\\"message\\\":\\\"...\\\"}\"  -> HTTP 503: ...\n  const m = t.match(/^(\\d{3}) - \"?([\\s\\S]*?)\"?$/);\n  if (m) {\n    let inner = m[2].replace(/\\\\\"/g, '\"');\n    try { const j = JSON.parse(inner); inner = j.message || j.error_description || j.code || inner; } catch {}\n    t = 'HTTP ' + m[1] + ': ' + inner;\n  }\n  return t.replace(/\\s+/g, ' ').slice(0, 200);\n}\nreturn [event($input.first().json.query.lead_id, 'crm_contact', 'retrying', 'HTTP 503 from the simulated HubSpot outage')];"
